# ---- secrets: never commit ----
.dev.vars
.env
.env.*
!.env.example
*.pem
*.key

# ---- wrangler local state (contains account id + session) ----
.wrangler/
**/.wrangler/
wrangler.toml.bak

# ---- dependencies ----
node_modules/
**/node_modules/
package-lock.json.bak

# ---- headless-Chrome test profiles (hundreds of MB of junk) ----
cp-*/
cp-curves/
cp-err*/
cp-final*/
cp-guard/
cdp-*/
*-profile/
chrome-profile/

# ---- test output ----
*.png
!docs/**/*.png
tail*.log
tail*.json
*.log
gate-test.html
worksheet-test.html
ws-cookie.txt

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ---- generated by scripts/sync.mjs ----
build/

# ---- local webhook credentials (never commit) ----
.webhook-local.env

# ---- scripts/pdf-import spike output (regenerate with npm run demo / lkpd) ----
scripts/pdf-import/out/
